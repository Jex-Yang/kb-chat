#!/usr/bin/env bash
# KBChat 提交前防泄露检查。
# 启用（每人克隆后执行一次）：git config core.hooksPath .githooks
# 作用：阻止把 .env（访问密码 / API Key）、运行数据、真实哈希提交进仓库。
set -u

fail=0
msg() { printf '\n[pre-commit] %s\n' "$1" >&2; }

# 1) 路径检查：环境变量文件、数据库、私钥
while IFS= read -r path; do
  [ -z "$path" ] && continue
  base="${path##*/}"
  case "$base" in
    .env|.env.*)
      [ "$base" = ".env.example" ] || { msg "拒绝提交 ${path}（环境变量文件，含访问密码/API Key）"; fail=1; }
      ;;
  esac
  case "$path" in
    data/*|*.db|*.sqlite|*.sqlite3|*.pem|*.key)
      msg "拒绝提交 ${path}（运行数据或密钥）"; fail=1
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2) 内容检查：真实的访问密码哈希 / API Key 外形
added=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' || true)

if printf '%s\n' "$added" | grep -qE 'pbkdf2_sha256\$[0-9]+\$[0-9a-f]{8,}\$[0-9a-f]{16,}'; then
  msg "拒绝提交：检测到访问密码哈希（只应存在于本地 .env）"; fail=1
fi
if printf '%s\n' "$added" | grep -qE '(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9_-]{16,}'; then
  msg "拒绝提交：检测到疑似 API Key"; fail=1
fi

if [ "$fail" -ne 0 ]; then
  printf '[pre-commit] 已阻止本次提交。确认是误报可执行：git commit --no-verify\n\n' >&2
  exit 1
fi
exit 0
